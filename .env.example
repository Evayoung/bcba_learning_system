# Copy to bcba/.env for local use. Never commit real credentials.

# --- App (later phases) ---
DATABASE_URL=sqlite:///./bcba_assistant.db
APP_ENV=development
APP_BASE_URL=http://localhost:5001
# Optional in local development; a random session secret is generated per run.
# Production must set SESSION_SECRET to at least 32 characters and use an https:// APP_BASE_URL.
SESSION_SECRET=
# Used once on an empty database to create the private learner account.
# Keep these in the deployment secret manager; startup does not overwrite existing accounts.
CANDIDATE_EMAIL=
CANDIDATE_PASSWORD=
CANDIDATE_NAME=BCBA Candidate

# --- AI tutor (Task 5) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45

# --- Page transcription (one-off ingestion CLI) ---
# VISION_PROVIDER=gemini|groq
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_VISION_MODEL=
